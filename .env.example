# Copy to `.env` to override defaults. All are optional — the app runs with the
# bundled placeholder media when these are unset.

# Move media (posters, videos) to a CDN. When empty, media is served from this
# site's /public (e.g. /scenes/afternoon/poster.webp).
VITE_MEDIA_BASE_URL=

# Which scene to start on (one of the ids in src/data/scenes.ts).
VITE_DEFAULT_SCENE_ID=afternoon
